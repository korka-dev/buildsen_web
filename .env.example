# Copiez ce fichier en .env.local (développement) ou définissez ces variables chez l'hébergeur. Ne publiez jamais les vraies valeurs.

# Adresse de l'API FastAPI, vue depuis le serveur Next.js (jamais exposée au navigateur).
# Développement : http://localhost:8000 · Docker Compose : http://backend:8000
BACKEND_URL=http://localhost:8000

# Même valeur que INTERNAL_API_KEY dans backend/.env (appels serveur à serveur qui modifient des données)
INTERNAL_API_KEY=
