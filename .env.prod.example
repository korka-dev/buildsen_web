# Copier en .env.prod (chmod 600) sur le serveur. Ne jamais le publier.
# Générer chaque secret avec :  openssl rand -hex 24

DOMAIN=buildsen.example.com            # sans https://, avec le DNS pointant vers l'IP du serveur
APP_URL=https://buildsen.example.com
ALLOWED_ORIGINS=https://buildsen.example.com

POSTGRES_PASSWORD=
CRON_SECRET=
INTERNAL_API_KEY=

# E-mails (Resend)
RESEND_API_KEY=
EMAIL_FROM=BUILDSEN <notifications@buildsen.com>

# Paiement : Wave et Orange Money par liens marchands
PAYMENT_PROVIDER=links
WAVE_PAY_LINK=
OM_PAY_LINK=
WAVE_WEBHOOK_SECRET=
OM_WEBHOOK_SECRET=
WAVE_GRACE_HOURS=0

# Assistant WhatsApp : off tant que Meta n'est pas configuré (sim est interdit en production)
WHATSAPP_PROVIDER=off
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BOT_NUMBER=
SOYNADE_API_KEY=

# Double authentification de l'administration : true (recommandé) ou false = e-mail + mot de passe seulement (déconseillé sur un site public)
ADMIN_2FA=true
